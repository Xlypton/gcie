#:kivy 2.0.0
Screen:

#:set background (30/255, 43/255, 51/255, 1)
#:set accent (1, 110/255, 64/255, 1)

<Screen>: 
    BoxLayout:
        orientation: "vertical"
        RelativeLayout:
            size_hint: None, 0.4
            background_color: 1, 110/255, 64/255, 1
            canvas.before:
                Color:
                    rgba: self.background_color
                Rectangle:
                    size: self.size
                    pos: self.pos
        Label:
            text: "Label1"
            color: 1, 110/255, 64/255, 1
            background_color: 30/255, 43/255, 51/255, 1
